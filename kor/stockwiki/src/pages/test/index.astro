---
import StockLayout from '../../layouts/StockLayout.astro';
import { readFileSync } from 'fs';
import { join } from 'path';

const dataDir = join(process.cwd(), 'data', 'stocks');
const samsung = JSON.parse(readFileSync(join(dataDir, '005930.json'), 'utf-8'));
const apple   = JSON.parse(readFileSync(join(dataDir, 'AAPL.json'),   'utf-8'));
const stocks  = [samsung, apple];

const FIN_ROWS = [
  ['매출액','revenue',false],['매출총이익','gross_profit',false],
  ['영업이익','op_profit',false],['순이익','net_profit',false],
  ['영업현금흐름','op_cashflow',false],
  ['매출총이익률','gross_margin',true],['영업이익률','op_margin',true],
  ['순이익률','net_margin',true],['ROE','roe',true],['부채비율','debt_ratio',true],
] as [string, string, boolean][];

const STAR_NAMES: Record<string,string> = {
  valuation:'가치평가', profitability:'수익성',
  health:'재무건전성', growth:'성장성', moat:'경제적 해자',
};
const STAR_WEIGHT: Record<string,string> = {
  valuation:'25%', profitability:'25%', growth:'20%', health:'15%', moat:'15%',
};

function fmtNum(v: any, unit='') {
  if (v == null) return null;
  const n = Number(v);
  if (isNaN(n)) return null;
  return n.toLocaleString('ko-KR') + unit;
}
function fmtPct(v: any) {
  if (v == null) return null;
  return Number(v).toFixed(1) + '%';
}
function cell(v: any, isPct=false, isNeg=false) {
  const s = isPct ? fmtPct(v) : fmtNum(v);
  if (!s) return '<td class="na">-</td>';
  const cls = isNeg ? (Number(v) < 0 ? 'neg' : '') : '';
  return `<td class="${cls}">${s}</td>`;
}
function stars(n: number) {
  const full = Math.round(n);
  return '★'.repeat(full) + '☆'.repeat(5 - full);
}
function starColor(n: number) {
  if (n >= 4) return '#3fb950';
  if (n >= 3) return '#d29922';
  return '#f85149';
}
---

<StockLayout title="Data Test · StockWiki">
<div class="test-wrap">

  <div class="top-bar">
    <h1>🧪 Data Test Page</h1>
    <p>삼성전자(005930) + Apple(AAPL) 전체 수집 데이터 검증용</p>
    <span class="ts">빌드: {new Date().toLocaleString('ko-KR')}</span>
  </div>

  {stocks.map(stock => {
    const v = stock.valuation ?? {};
    const m = stock.metrics ?? {};
    const r = stock.rating ?? {};
    const rd = r.detail ?? {};
    const isKR = stock.market === 'KR';
    const priceStr = isKR
      ? stock.price?.current?.toLocaleString()+'원'
      : '$'+stock.price?.current?.toFixed(2);
    const capStr = isKR
      ? (m.market_cap_억 ? m.market_cap_억.toLocaleString()+'억원' : '-')
      : (m.market_cap_M ? '$'+m.market_cap_M.toLocaleString()+'M' : '-');
    const unit = isKR ? '억원' : '백만$';
    const fa = stock.financials_annual ?? [];
    const fq = stock.financials_quarterly ?? [];
    const hv = stock.historical_valuation ?? [];

    return (
    <section class="stock-sec">
      <div class="sec-header">
        <span class="tick">{stock.ticker}</span>
        <span class="sname">{stock.name}</span>
        <span class="badge mkt">{stock.market}</span>
        <span class="badge sec">{stock.sector}</span>
        <span class="price-big">{priceStr}</span>
        <span class={`chg ${stock.price?.change_pct >= 0 ? 'pos' : 'neg'}`}>
          {stock.price?.change_pct?.toFixed(2)}%
        </span>
      </div>

      {/* ─── 1. 기본 정보 ─── */}
      <div class="block">
        <div class="btitle">1. 기본 정보</div>
        <div class="kv-row">
          <div class="kv"><span>시가총액</span><b>{capStr}</b></div>
          <div class="kv"><span>52주 최고</span><b>{isKR ? stock.price?.week52_high?.toLocaleString()+'원' : '$'+stock.price?.week52_high?.toFixed(2)}</b></div>
          <div class="kv"><span>52주 최저</span><b>{isKR ? stock.price?.week52_low?.toLocaleString()+'원' : '$'+stock.price?.week52_low?.toFixed(2)}</b></div>
          <div class="kv"><span>발행주식수</span><b>{m.shares_outstanding?.toLocaleString()}</b></div>
          {!isKR && <div class="kv"><span>유통주식수</span><b>{m.float_shares?.toLocaleString()}</b></div>}
          <div class="kv"><span>베타</span><b>{m.beta}</b></div>
          <div class="kv"><span>배당수익률</span><b>{stock.dividends?.yield?.toFixed(2)}%</b></div>
          {!isKR && <div class="kv"><span>배당성향</span><b>{m.payout_ratio != null ? m.payout_ratio+'%' : '-'}</b></div>}
          <div class="kv"><span>업데이트</span><b>{stock.updated_at}</b></div>
        </div>
      </div>

      {/* ─── 2. PER 두 종류 ─── */}
      <div class="block highlight-block">
        <div class="btitle">2. PER — 두 가지 방식 비교</div>
        <div class="per-source-note">📌 출처: {v.per_source ?? m.per_source ?? isKR ? 'FnGuide 재무데이터 + PyKrx 주가' : 'yfinance'}</div>
        <div class="per-grid">
          <div class="per-card">
            <div class="per-label">연간 PER<span class="per-sub">(Annual)</span></div>
            <div class="per-value">{v.per_annual_calc?.toFixed(2) ?? '-'}<span class="per-x">x</span></div>
            <div class="per-desc">{isKR ? '최근 12월 결산 연도 순이익 기준' : '최근 회계연도(FY) 순이익 기준'}<br/>
              {isKR ? `2025/12 순이익: ${fa.find((x:any)=>x.label==='2025/12')?.net_profit?.toLocaleString()}억원` : `${fa[fa.length-1]?.label} 순이익: $${fa[fa.length-1]?.net_profit?.toLocaleString()}M`}
            </div>
          </div>
          <div class="per-card">
            <div class="per-label">TTM PER<span class="per-sub">(최근 4분기)</span></div>
            <div class="per-value">{(v.per_ttm_calc ?? v.per_ttm)?.toFixed(2) ?? '-'}<span class="per-x">x</span></div>
            <div class="per-desc">최근 4분기 순이익 합산 기준<br/>
              {fq.slice(-4).map((x:any)=>x.label).join(' + ')}<br/>
              합계: {fq.slice(-4).reduce((s:number,x:any)=>s+(x.net_profit||0),0).toLocaleString()}{unit}
            </div>
          </div>
          {isKR && v.per_krx != null && (
            <div class="per-card">
              <div class="per-label">KRX 공식 PER</div>
              <div class="per-value">{v.per_krx?.toFixed(2) ?? '-'}<span class="per-x">x</span></div>
              <div class="per-desc">한국거래소 공식 발표값<br/>(직접 계산 아님)</div>
            </div>
          )}
          <div class="per-card ref">
            <div class="per-label">업종 평균 PER</div>
            <div class="per-value">{v.per_industry_avg?.toFixed(1)}<span class="per-x">x</span></div>
            <div class="per-desc">비교 기준값</div>
          </div>
        </div>
      </div>

      {/* ─── 3. Finviz 스타일 종합 지표 ─── */}
      <div class="block">
        <div class="btitle">3. 종합 재무 지표 (Finviz 스타일)</div>
        <div class="finviz-grid">
          {/* 밸류에이션 */}
          <div class="fv-group">
            <div class="fv-group-title">밸류에이션</div>
            <div class="fv-row"><span>PER (연간)</span><b>{v.per_annual_calc?.toFixed(2) ?? '-'}</b></div>
            <div class="fv-row"><span>PER (TTM)</span><b>{(v.per_ttm_calc ?? v.per_ttm)?.toFixed(2) ?? '-'}</b></div>
            {!isKR && <div class="fv-row"><span>Forward PER</span><b>{m.forward_pe?.toFixed(2) ?? '-'}</b></div>}
            {!isKR && <div class="fv-row"><span>PEG</span><b>{m.peg_ratio?.toFixed(2) ?? '-'}</b></div>}
            <div class="fv-row"><span>PBR</span><b>{(v.pbr ?? m.pb_ratio)?.toFixed(2) ?? '-'}</b></div>
            <div class="fv-row"><span>PSR</span><b>{m.ps_ratio?.toFixed(2) ?? '-'}</b></div>
            {!isKR && <div class="fv-row"><span>EV/EBITDA</span><b>{m.ev_ebitda?.toFixed(2) ?? '-'}</b></div>}
            {!isKR && <div class="fv-row"><span>EV/Revenue</span><b>{m.ev_revenue?.toFixed(2) ?? '-'}</b></div>}
          </div>
          {/* 수익성 */}
          <div class="fv-group">
            <div class="fv-group-title">수익성 마진</div>
            <div class="fv-row"><span>매출총이익률</span><b>{(m.gross_margin != null ? m.gross_margin+'%' : '-')}</b></div>
            <div class="fv-row"><span>영업이익률</span><b>{(m.op_margin != null ? m.op_margin+'%' : '-')}</b></div>
            <div class="fv-row"><span>순이익률</span><b>{(m.net_margin != null ? m.net_margin+'%' : '-')}</b></div>
            <div class="fv-row"><span>ROE</span><b>{(m.roe != null ? m.roe+'%' : '-')}</b></div>
            <div class="fv-row"><span>ROA</span><b>{(m.roa != null ? m.roa+'%' : '-')}</b></div>
            {!isKR && <div class="fv-row"><span>EPS (TTM)</span><b>{m.eps_ttm != null ? '$'+m.eps_ttm : '-'}</b></div>}
            {!isKR && <div class="fv-row"><span>EPS (Fwd)</span><b>{m.eps_forward != null ? '$'+m.eps_forward : '-'}</b></div>}
          </div>
          {/* 재무건전성 */}
          <div class="fv-group">
            <div class="fv-group-title">재무건전성</div>
            <div class="fv-row"><span>유동비율</span><b>{m.current_ratio?.toFixed(2) ?? '-'}</b></div>
            <div class="fv-row"><span>당좌비율</span><b>{m.quick_ratio?.toFixed(2) ?? '-'}</b></div>
            <div class="fv-row"><span>부채/자본</span><b>{m.debt_to_equity?.toFixed(2) ?? '-'}</b></div>
            {!isKR && <div class="fv-row"><span>현금</span><b>{m.total_cash_M != null ? '$'+m.total_cash_M?.toLocaleString()+'M' : '-'}</b></div>}
            {!isKR && <div class="fv-row"><span>총부채</span><b>{m.total_debt_M != null ? '$'+m.total_debt_M?.toLocaleString()+'M' : '-'}</b></div>}
            {!isKR && <div class="fv-row"><span>FCF</span><b>{m.free_cashflow_M != null ? '$'+m.free_cashflow_M?.toLocaleString()+'M' : '-'}</b></div>}
            {isKR && <div class="fv-row"><span>영업현금흐름</span><b>{m.op_cashflow_억 != null ? m.op_cashflow_억?.toLocaleString()+'억원' : '-'}</b></div>}
          </div>
          {/* 성장 & 애널리스트 */}
          <div class="fv-group">
            <div class="fv-group-title">성장 & 애널리스트</div>
            {!isKR && <div class="fv-row"><span>매출 성장(YoY)</span><b class={m.revenue_growth_yoy >= 0 ? 'pos' : 'neg'}>{m.revenue_growth_yoy != null ? m.revenue_growth_yoy+'%' : '-'}</b></div>}
            {!isKR && <div class="fv-row"><span>EPS 성장(YoY)</span><b class={m.earnings_growth_yoy >= 0 ? 'pos' : 'neg'}>{m.earnings_growth_yoy != null ? m.earnings_growth_yoy+'%' : '-'}</b></div>}
            {!isKR && <div class="fv-row"><span>목표주가</span><b>{m.target_price != null ? '$'+m.target_price?.toFixed(2) : '-'}</b></div>}
            {!isKR && <div class="fv-row"><span>애널리스트 추천</span><b>{m.analyst_recom?.toFixed(2) ?? '-'} <span class="small-txt">({m.analyst_count}명)</span></b></div>}
            {!isKR && <div class="fv-row"><span>SMA 50일</span><b>{m.sma_50 != null ? '$'+m.sma_50?.toFixed(2) : '-'}</b></div>}
            {!isKR && <div class="fv-row"><span>SMA 200일</span><b>{m.sma_200 != null ? '$'+m.sma_200?.toFixed(2) : '-'}</b></div>}
            <div class="fv-row"><span>베타</span><b>{m.beta}</b></div>
            {!isKR && <div class="fv-row"><span>BPS</span><b>{m.book_value_per_share != null ? '$'+m.book_value_per_share : '-'}</b></div>}
          </div>
        </div>
      </div>

      {/* ─── 4. 종합 별점 (근거 포함) ─── */}
      <div class="block">
        <div class="btitle">4. 종합 별점 — 항목별 기준 및 근거</div>
        <div class="rating-header">
          <div class="overall-box">
            <div class="ov-num">{r.overall?.toFixed(1)}</div>
            <div class="ov-stars" style={`color:${starColor(r.overall??0)}`}>{stars(r.overall??0)}</div>
            <div class="ov-label">{r.label}</div>
          </div>
          <div class="weight-note">
            가중치: 가치평가 25% / 수익성 25% / 성장성 20% / 재무건전성 15% / 경제적해자 15%
          </div>
        </div>
        <div class="cat-list">
          {Object.entries(r.stars ?? {}).map(([k, sv]) => (
            <div class="cat-item">
              <div class="cat-top">
                <span class="cat-name">{STAR_NAMES[k] ?? k}</span>
                <span class="cat-weight">가중치 {STAR_WEIGHT[k]}</span>
                <span class="cat-stars" style={`color:${starColor(sv as number)}`}>{stars(sv as number)}</span>
                <span class="cat-score">{sv}/5</span>
              </div>
              <div class="cat-reason">💬 {rd[k] ?? '-'}</div>
            </div>
          ))}
        </div>
      </div>

      {/* ─── 5. 연간 재무제표 ─── */}
      <div class="block">
        <div class="btitle">
          5. 연간 재무제표
          {isKR && <span class="note-badge">12월 결산 기준만 표시</span>}
          <span class="unit-badge">{unit}</span>
          <span class="cnt-badge">{fa.length}개 연도</span>
        </div>
        {fa.length === 0
          ? <p class="nodata">⚠️ 데이터 없음</p>
          : <div class="tw"><table class="dt">
              <thead><tr>
                <th class="lh">항목</th>
                {fa.map((x:any) => <th>{x.label}</th>)}
              </tr></thead>
              <tbody>
                {FIN_ROWS.map(([label, key, isPct]) => (
                  <tr>
                    <td class="lc">{label}</td>
                    {fa.map((x:any) => {
                      const val = x[key];
                      if (val == null) return <td class="na">-</td>;
                      const cls = key==='net_profit'||key==='op_profit' ? (val<0?'neg':'pos2') : '';
                      const disp = isPct ? val.toFixed(1)+'%' : val.toLocaleString('ko-KR');
                      return <td class={cls}>{disp}</td>;
                    })}
                  </tr>
                ))}
              </tbody>
            </table></div>
        }
      </div>

      {/* ─── 6. 분기 재무제표 ─── */}
      <div class="block">
        <div class="btitle">
          6. 분기 재무제표
          <span class="unit-badge">{unit}</span>
          <span class="cnt-badge">{fq.length}개 분기</span>
        </div>
        {fq.length === 0
          ? <p class="nodata">⚠️ 데이터 없음</p>
          : <div class="tw"><table class="dt">
              <thead><tr>
                <th class="lh">항목</th>
                {fq.map((x:any) => <th>{x.label}</th>)}
              </tr></thead>
              <tbody>
                {FIN_ROWS.map(([label, key, isPct]) => (
                  <tr>
                    <td class="lc">{label}</td>
                    {fq.map((x:any) => {
                      const val = x[key];
                      if (val == null) return <td class="na">-</td>;
                      const cls = key==='net_profit'||key==='op_profit' ? (val<0?'neg':'pos2') : '';
                      const disp = isPct ? val.toFixed(1)+'%' : val.toLocaleString('ko-KR');
                      return <td class={cls}>{disp}</td>;
                    })}
                  </tr>
                ))}
              </tbody>
            </table></div>
        }
      </div>

      {/* ─── 7. 역사적 PER/PBR ─── */}
      <div class="block">
        <div class="btitle">
          7. 역사적 PER / PBR ({hv.length}개 포인트)
        </div>
        <div class="source-box">
          📡 데이터 출처: <strong>{stock.historical_source ?? '-'}</strong>
        </div>
        {hv.length === 0
          ? <p class="nodata">⚠️ 데이터 없음</p>
          : <div class="tw"><table class="dt">
              <thead><tr>
                <th class="lh">날짜</th><th>주가</th><th>PER</th><th>PBR</th>
                <th>EPS</th><th>BPS</th><th>출처</th>
              </tr></thead>
              <tbody>
                {hv.map((h:any) => (
                  <tr>
                    <td class="lc">{h.date}</td>
                    <td>{isKR ? h.price?.toLocaleString()+'원' : '$'+(h.price?.toFixed(2)??'-')}</td>
                    <td class={h.per==null?'na':''}>{h.per?.toFixed(2)??'-'}</td>
                    <td class={h.pbr==null?'na':''}>{h.pbr?.toFixed(2)??'-'}</td>
                    <td class="small">{h.eps?.toFixed(isKR?0:4)??'-'}</td>
                    <td class="small">{h.bps?.toFixed(isKR?0:2)??'-'}</td>
                    <td class="small source-td">{h.source ?? '-'}</td>
                  </tr>
                ))}
              </tbody>
            </table></div>
        }
      </div>

      {/* ─── 8. Raw JSON ─── */}
      <div class="block">
        <div class="btitle">8. Raw JSON</div>
        <details>
          <summary>클릭해서 펼치기 (전체 원본 데이터)</summary>
          <pre class="raw">{JSON.stringify(stock, null, 2)}</pre>
        </details>
      </div>

    </section>
    );
  })}

  <div class="footer">
    ⚠️ 이 페이지는 데이터 검증 전용입니다. '-' 또는 빈 값이 있으면 수집 실패 항목입니다.
  </div>
</div>
</StockLayout>

<style>
  .test-wrap { max-width: 1200px; }
  .top-bar { margin-bottom: 32px; }
  .top-bar h1 { font-size: 1.5rem; font-weight: 800; margin-bottom: 4px; }
  .top-bar p { color: var(--text2); margin-bottom: 4px; }
  .ts { font-size: 0.78rem; color: var(--text2); }

  .stock-sec {
    background: var(--bg2); border: 1px solid var(--border);
    border-radius: 14px; padding: 24px; margin-bottom: 48px;
  }
  .sec-header {
    display: flex; align-items: center; gap: 12px;
    flex-wrap: wrap; margin-bottom: 20px; padding-bottom: 16px;
    border-bottom: 1px solid var(--border);
  }
  .tick { background: var(--blue); color:#fff; padding:3px 10px; border-radius:6px; font-family:monospace; font-size:1rem; }
  .sname { font-size:1.3rem; font-weight:800; }
  .badge { font-size:0.72rem; padding:2px 8px; border-radius:4px; background:var(--bg3); color:var(--text2); }
  .price-big { font-size:1.4rem; font-weight:700; margin-left:auto; }
  .chg { font-size:0.9rem; font-weight:600; }
  .chg.pos { color:var(--red); }
  .chg.neg { color:var(--blue); }

  .block {
    border:1px solid var(--border); border-radius:10px;
    padding:16px; margin-bottom:16px; background:var(--bg);
  }
  .highlight-block { border-color: var(--yellow); }
  .btitle {
    font-weight:700; font-size:0.9rem; color:var(--blue);
    margin-bottom:14px; display:flex; align-items:center; gap:8px; flex-wrap:wrap;
  }
  .note-badge { background:#1a2a0d; color:#3fb950; font-size:0.72rem; padding:2px 8px; border-radius:4px; font-weight:400; }
  .unit-badge { background:var(--bg3); color:var(--yellow); font-size:0.72rem; padding:2px 8px; border-radius:4px; font-weight:400; }
  .cnt-badge  { background:var(--bg3); color:var(--text2);  font-size:0.72rem; padding:2px 8px; border-radius:4px; font-weight:400; }

  /* KV */
  .kv-row { display:flex; flex-wrap:wrap; gap:10px; }
  .kv { background:var(--bg2); border-radius:8px; padding:10px 14px; display:flex; flex-direction:column; gap:3px; min-width:130px; }
  .kv span { font-size:0.72rem; color:var(--text2); }
  .kv b { font-size:0.95rem; font-weight:700; }

  /* PER 두 종류 */
  .per-source-note { font-size:0.78rem; color:var(--text2); margin-bottom:12px; }
  .per-grid { display:flex; gap:12px; flex-wrap:wrap; }
  .per-card {
    background:var(--bg2); border:1px solid var(--border); border-radius:10px;
    padding:14px 18px; min-width:180px; flex:1;
  }
