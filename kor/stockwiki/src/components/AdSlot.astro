---
export interface Props {
  type: 'adsense' | 'coupang';
  slot?: string;
  style?: string;
  className?: string;
}
const { type, slot = 'XXXXXXXXXX', style = 'display:block', className = '' } = Astro.props;
---

{type === 'adsense' && (
  <div class={`ad-slot ${className}`}>
    <ins class="adsbygoogle"
      style={style}
      data-ad-client="ca-pub-XXXXXXXXXXXXXXXX"
      data-ad-slot={slot}
      data-ad-format="auto"
      data-full-width-responsive="true">
    </ins>
    <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
  </div>
)}

{type === 'coupang' && (
  <div class={`ad-slot coupang-slot ${className}`}>
    <iframe
      src="https://ads-partners.coupang.com/widgets.html?id=XXXXXXXX&template=carousel&trackingCode=AF_XXXXXXXX&subId=&width=680&height=140&tsource="
      width="100%"
      height="140"
      frameborder="0"
      scrolling="no"
      referrerpolicy="unsafe-url"
      loading="lazy">
    </iframe>
  </div>
)}

<style>
  .ad-slot {
    margin: 24px 0;
    text-align: center;
    min-height: 90px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .coupang-slot { min-height: 140px; }
  .ad-slot ins, .ad-slot iframe { max-width: 100%; }
</style>
