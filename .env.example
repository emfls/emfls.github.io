# Naver Search Ads API (Tools > API Manager)
NAVER_SEARCHAD_API_KEY=
NAVER_SEARCHAD_SECRET_KEY=
NAVER_SEARCHAD_CUSTOMER_ID=

# NAVER Cloud Platform > NAVER API HUB > Data Lab > 검색어 트렌드
NAVER_API_HUB_CLIENT_ID=
NAVER_API_HUB_CLIENT_SECRET=

# Enable Search > Web document search in the API HUB application.
# Optional dedicated API HUB application; these take priority over the DataLab application keys.
# NAVER_WEB_SEARCH_API_HUB_CLIENT_ID=
# NAVER_WEB_SEARCH_API_HUB_CLIENT_SECRET=
# Legacy Naver Developers applications may instead use these names.
# NAVER_WEB_SEARCH_CLIENT_ID=
# NAVER_WEB_SEARCH_CLIENT_SECRET=

# Optional DataLab quota policy (defaults shown)
DATALAB_MONTHLY_LIMIT=50000
DATALAB_RESERVE_RATIO=0.10

# Legacy Naver Developers names (existing applications only)
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=
# NAVER_DATALAB_CLIENT_ID=
# NAVER_DATALAB_CLIENT_SECRET=
